# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# AI provider: anthropic | gemini | openrouter
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Speech-to-text (голосовые сообщения). Пусто = функция выключена.
# STT_PROVIDER: openrouter | groq
STT_PROVIDER=openrouter
GROQ_API_KEY=
STT_MODEL=openai/whisper-large-v3:free
VOICE_MAX_DURATION_SECONDS=300

# Email (SMTP + IMAP). Пусто = функция выключена.
EMAIL_ADDRESS=
EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
IMAP_HOST=
IMAP_PORT=993

# Browser automation (Playwright)
BROWSER_TIMEOUT_MS=15000

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/personal_ai_agent

# Limits / cost control
DAILY_TOKEN_LIMIT=200000
CONVERSATION_HISTORY_WINDOW=10

# Reminder worker
REMINDER_POLL_INTERVAL_SECONDS=30

# Долгоживущие фоновые задания (Job)
JOB_POLL_INTERVAL_SECONDS=60
JOB_MAX_RUNS=100

# Logging
LOG_LEVEL=INFO
