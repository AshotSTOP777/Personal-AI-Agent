# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# AI provider: anthropic | gemini
AI_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/personal_ai_agent

# Limits / cost control
DAILY_TOKEN_LIMIT=200000
CONVERSATION_HISTORY_WINDOW=10

# Reminder worker
REMINDER_POLL_INTERVAL_SECONDS=30

# Logging
LOG_LEVEL=INFO
